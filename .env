# ---- LLM ----
# Free key: https://aistudio.google.com/app/apikey

GOOGLE_API_KEY=

# gemini-3.5-flash-lite (default, most generous free limits) | gemini-3.5-flash | gemini-3.8-flash | gemini-3.1-flash-lite

GEMINI_MODEL=gemini-3.5-flash-lite

# ---- Embeddings ----
# local = all-MiniLM-L6-v2 (semantic, ~80 MB one-time download) | hash = offline keyword hashing

EMBEDDING_BACKEND=local

# ---- Retrieval / agents ----
TOP_K=6
MAX_AGENT_LOOPS=2
LLM_VALIDATION=true

# ---- Ingestion ----
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TABLE_ROWS_PER_CHUNK=8
MAX_FILE_MB=20
MAX_QUESTION_CHARS=1000
